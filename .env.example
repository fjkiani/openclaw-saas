# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/openclaw

# ─── Auth (Clerk) ─────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
SESSION_SECRET=change-me-in-production

# ─── Benchmark + ZOA Service (LEGACY / OPTIONAL) ─────────────────────────────
# STATUS (Sprint A, 2026-07): The external mcp-universe-benchmarks FastAPI
# service is NOT deployed. Live L1-L4 benchmarking runs in-process via
# `artifacts/api-server/src/lib/archon/benchmarkRunner.ts`.
# The variables below remain in case you spin up an external judge — the
# client (`src/lib/benchmarkClient.ts`) now does a fast reachability
# preflight and falls back cleanly when the URL is unreachable.
BENCHMARK_SERVICE_URL=http://localhost:8001
# Set to "false" to skip the external benchmark gate entirely (recommended
# default while the FastAPI service is not deployed).
BENCHMARK_GATE_ENABLED=false

# ─── Agent Robustness Benchmarks (in-process, read-only corpus) ──────────────
# Override the corpus location if you check the JSONL out to a separate volume.
# Default: <api-server-cwd>/corpus/stress-benchmarks
# STRESS_CORPUS_DIR=./corpus/stress-benchmarks

# ─── Kairos Execution Service ─────────────────────────────────────────────────
# Explicit env var for the Kairos orchestration/execution contract.
# Points to the same service as BENCHMARK_SERVICE_URL for now; kept separate
# so the two can diverge independently when Kairos becomes its own service.
KAIROS_SERVICE_URL=http://localhost:8001

# ─── ZOA Frontend ─────────────────────────────────────────────────────────────
# Base URL for ZOA agent API calls from the browser (Vite env var)
VITE_ZOA_SERVICE_URL=http://localhost:8001/api/v1/zoa

# ─── Render.com deployment ────────────────────────────────────────────────────
RENDER_API_KEY=
RENDER_OWNER_ID=

# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=

# ─── Modal (ZIE Factory trainer dispatch) ─────────────────────────────────────
# Set in the Railway/Modal environment; never commit real values.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# ─── Cloudflare R2 (artifact / embedding storage) ─────────────────────────────
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_ACCOUNT_ID=

# ─── Hugging Face (model/dataset pulls) ───────────────────────────────────────
HF_TOKEN=

# ─── OpenRouter (remote escalation models, e.g. gpt-oss-120b) ─────────────────
# Two keys supported for rotation / rate-limit failover.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=

# ─── bioRxiv API (manuscript ingestion source) ───────────────────────────────
BIORXIV_API_BASE_URL=https://api.biorxiv.org
BIORXIV_API_SERVER=biorxiv
BIORXIV_API_FORMAT=json
BIORXIV_API_PAGE_SIZE=100
