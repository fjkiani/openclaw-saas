# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/openclaw

# ─── Auth (Clerk) ─────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
SESSION_SECRET=change-me-in-production

# ─── Benchmark + ZOA Service (mcp-universe-benchmarks) ───────────────────────
# URL of the running mcp-benchmarks FastAPI service (benchmark gate + ZOA agents)
BENCHMARK_SERVICE_URL=http://localhost:8001
# Set to "false" to allow skill installs even when benchmark service is offline
BENCHMARK_GATE_ENABLED=true

# ─── Kairos Execution Service ─────────────────────────────────────────────────
# Explicit env var for the Kairos orchestration/execution contract.
# Points to the same service as BENCHMARK_SERVICE_URL for now; kept separate
# so the two can diverge independently when Kairos becomes its own service.
KAIROS_SERVICE_URL=http://localhost:8001

# ─── ZOA Frontend ─────────────────────────────────────────────────────────────
# Base URL for ZOA agent API calls from the browser (Vite env var)
VITE_ZOA_SERVICE_URL=http://localhost:8001/api/v1/zoa

# ─── Render.com deployment ────────────────────────────────────────────────────
RENDER_API_KEY=
RENDER_OWNER_ID=

# ─── Node ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
