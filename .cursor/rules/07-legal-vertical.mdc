```typescript
// Provider-aware. Each entry specifies provider + API key env var.
// Groq routes to api.groq.com/openai/v1 (no HTTP-Referer/X-Title headers).
// OpenRouter routes to openrouter.ai/api/v1.

const SPECIALIST_MODEL_CHAIN: ModelEntry[] = [
  { id: "llama-3.3-70b-versatile", provider: "groq",       apiKeyEnv: "GROQ_API_KEY"         },  // primary
  { id: "meta-llama/llama-3.3-70b-instruct:free", provider: "openrouter", apiKeyEnv: "OPENROUTER_API_KEY"   },
  { id: "meta-llama/llama-3.3-70b-instruct:free", provider: "openrouter", apiKeyEnv: "OPENROUTER_API_KEY_2" },
  { id: "openai/gpt-oss-120b:free",               provider: "openrouter", apiKeyEnv: "OPENROUTER_API_KEY"   },
  { id: "openai/gpt-oss-20b:free",                provider: "openrouter", apiKeyEnv: "OPENROUTER_API_KEY_2" },
];

const INTAKE_MODEL_CHAIN: ModelEntry[] = [
  { id: "openai/gpt-oss-20b:free",  provider: "openrouter", apiKeyEnv: "OPENROUTER_API_KEY"  },
  { id: "openai/gpt-oss-120b:free", provider: "openrouter", apiKeyEnv: "OPENROUTER_API_KEY"  },
  { id: "liquid/lfm-2.5-1.2b-instruct:free", provider: "openrouter", apiKeyEnv: "OPENROUTER_API_KEY", use_rag: true },
];
```

**Required env vars:** `GROQ_API_KEY`, `OPENROUTER_API_KEY`, `OPENROUTER_API_KEY_2`

On 429: try next entry (may be different key or provider). On parse failure: retry same entry once with explicit JSON instruction. On other errors: fail fast.

