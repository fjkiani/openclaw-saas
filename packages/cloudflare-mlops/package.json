{
  "name": "@workspace/openclaw-mlops",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Workers-based MLOps ingest + aggregate for OpenClaw MCP fleet.",
  "type": "module",
  "main": "src/worker.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dry": "wrangler deploy --dry-run --outdir=dist/",
    "d1:init": "wrangler d1 execute openclaw-mcp-metrics --file=sql/schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250717.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.85.0"
  }
}
